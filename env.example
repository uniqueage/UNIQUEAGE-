# ===========================================================================
# UAGE — environment variables (TEMPLATE)
# ===========================================================================
# NOTE: this file is named `env.example` rather than `.env.example` because
# the Freebuff workspace blocks creation of any `.env*` path. Copy it into
# place yourself with the one-liner below, which also creates a real `.env`:
#
#     cp env.example .env.example && cp env.example .env
#
# `.env` is gitignored. NEVER commit it, and never paste real secrets into
# source files, migrations, or frontend JavaScript.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. PUBLIC client configuration
# ---------------------------------------------------------------------------
# These two values are DESIGNED to be visible in the browser. The anon key is
# a publishable key; Row Level Security is what actually protects the data.
# They are the ONLY Supabase values that may appear in frontend code.
#
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------------
# 2. SERVER-ONLY secrets — must never reach the browser
# ---------------------------------------------------------------------------
# The service-role key bypasses every RLS policy and grants full database
# access. It is used ONLY by server-side tooling (migrations, seeding, admin
# scripts) and must never be imported by anything under js/.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the Supabase CLI to apply
# migrations. Dashboard -> Project Settings -> Database -> Connection string
SUPABASE_DB_URL=

# Project reference (the subdomain part of SUPABASE_URL), used by the CLI.
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# 3. Test-only credentials (used by supabase/tests, never by the site)
# ---------------------------------------------------------------------------
# A throwaway customer and a throwaway administrator, used to prove the RLS
# policies behave correctly.
UAGE_TEST_CUSTOMER_EMAIL=
UAGE_TEST_CUSTOMER_PASSWORD=
UAGE_TEST_ADMIN_EMAIL=
UAGE_TEST_ADMIN_PASSWORD=
